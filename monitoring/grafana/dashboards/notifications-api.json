      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "{container=\"backend_app\"} |~ \"ERROR|CRITICAL|Traceback\"",
          "datasource": {
            "type": "loki",
