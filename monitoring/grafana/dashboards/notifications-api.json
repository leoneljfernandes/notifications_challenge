      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 21,
      "type": "table",
      "title": "Trazas recientes",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "queryType": "traceqlSearch",
          "limit": 20,
          "tableType": "traces",
          "filters": [
            {
              "id": "service-name",
              "tag": "service.name",
              "operator": "=",
              "scope": "resource",
              "value": [
                "notifications-api"
              ],
              "valueType": "string"
            }
          ],
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 22,
      "type": "table",
      "title": "Trazas lentas (> 500ms)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 66,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"notifications-api\" && duration > 500ms }",
          "limit": 20,
          "tableType": "traces",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
